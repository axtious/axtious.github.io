---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../config/site';
---

<BaseLayout
  title="Mes univers"
  description="My Dare, Omnivya, Sanad et ScaLion : les projets qui nourrissent le carnet de Taous Deneuve."
>
  <section class="page-section wrap">
    <header class="page-heading">
      <p class="eyebrow">PLUSIEURS AVENTURES. UN MÊME FIL.</p>
      <h1>Mes univers</h1>
      <p>
        Des projets différents, qui nourrissent une même envie de construire et
        de comprendre.
      </p>
    </header>
    <div class="universe-list">
      {categories.map((category) => (
        <section id={category.slug}>
          <span class="universe-number">{category.number}</span>
          <div>
            <h2>{category.name}</h2>
            <p>{category.description}</p>
          </div>
          <a class="text-link" href={`/categories/${category.slug}/`}>
            Les pages du carnet <span aria-hidden="true">↗</span>
          </a>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
