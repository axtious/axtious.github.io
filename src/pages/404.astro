---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" noindex>
  <section class="page-section wrap not-found">
    <p class="eyebrow">404 · UNE PAGE ÉGARÉE</p>
    <h1>
      On reprend
      <br />
      <em>le fil ?</em>
    </h1>
    <p>Cette page n’existe pas, ou son adresse a changé.</p>
    <a class="button" href="/blog/">
      Revenir au carnet <span aria-hidden="true">↗</span>
    </a>
  </section>
</BaseLayout>
